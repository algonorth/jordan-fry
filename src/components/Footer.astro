---
import { site, telHref, mailHref } from '../data/site';
import { footer } from '../data/copy';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-12 lg:py-16">
  <div class="container-site">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href={withBase('/')} class="focus-ring rounded-sm font-display text-xl tracking-tight text-fg">
          {site.name}
        </a>
        <p class="mt-3 max-w-md text-sm text-fg-2">{footer.line}</p>
      </div>
      <div class="flex flex-col text-sm">
        <a
          href={telHref}
          class="focus-ring rounded-sm py-2 text-fg tabular-nums transition-colors duration-(--duration-fast) hover:text-amber-300"
        >
          {site.phone.display}
        </a>
        <a
          href={mailHref}
          class="focus-ring rounded-sm py-2 text-fg transition-colors duration-(--duration-fast) hover:text-amber-300"
        >
          {site.email}
        </a>
      </div>
    </div>
    <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-xs text-fg-3">
      <span>
        © {year} {site.name}
      </span>
      <span>{footer.legal}</span>
    </div>
  </div>
</footer>
