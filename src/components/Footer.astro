---
import { site, hasHic, telHref, mailHref } from '../data/site';
import { footer } from '../data/copy';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const linkCls =
  'focus-ring rounded-sm py-1 text-fg tabular-nums transition-colors duration-(--duration-fast) hover:text-amber-300';
---

<footer class="relative overflow-hidden border-t border-line">
  <div class="footer-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-site relative py-16 lg:py-24">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between md:gap-16">
      <div>
        <a
          href={withBase('/')}
          class="focus-ring inline-block rounded-sm font-display text-h1 font-[350] tracking-tight text-fg"
          style="font-variation-settings: 'opsz' 144"
        >
          {site.name}
        </a>
        <p class="mt-5 max-w-md text-sm text-fg-2">{footer.line}</p>
      </div>
      <div class="flex shrink-0 flex-col gap-1 text-sm md:items-end">
        <a href={telHref} class={linkCls}>
          {site.phone.display}
        </a>
        <a href={mailHref} class={linkCls}>
          {site.email}
        </a>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-xs text-fg-3 sm:flex-row sm:items-baseline sm:justify-between">
      <p class="flex flex-wrap gap-x-6 gap-y-1">
        <span>
          © {year} {site.name}
        </span>
        <span>{footer.legal}</span>
        {hasHic && <span>{footer.hic(site.hic)}</span>}
      </p>
      <a href="#top" class="link-quiet focus-ring self-start rounded-sm text-xs">
        {footer.backToTop}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-glow {
    background: radial-gradient(
      55% 70% at 8% 110%,
      color-mix(in oklab, var(--color-amber-400) 12%, transparent),
      transparent 70%
    );
  }
</style>
