---
import { hero } from '../data/copy';
import { site, telHref } from '../data/site';

const glance = [
  { label: hero.glance.basedIn, value: `${site.address.locality}, ${site.address.region}` },
  { label: hero.glance.since, value: String(site.founded) },
  { label: hero.glance.credentials, value: hero.licensed },
];
---

<section
  id="hero"
  data-hero
  aria-labelledby="hero-name"
  class="relative flex min-h-[calc(84svh-4rem)] flex-col justify-end pb-16 md:pb-24"
>
  <div class="container-site lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
    <div class="min-w-0">
      <h1
        id="hero-name"
        class="hero-name font-display text-display font-[350] text-fg"
        style="font-variation-settings: 'opsz' 144"
      >
        <span class="block">Jordan</span>
        <span class="block">Fry</span>
      </h1>
      <p class="mt-8 max-w-xl text-lead text-pretty text-fg-2">{hero.line}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-primary-cta>
        <a href={telHref} class="btn-primary focus-ring md:hidden">
          {hero.ctaMobile}
        </a>
        <a href="#contact" class="btn-primary focus-ring hidden md:inline-flex">
          {hero.ctaDesktop}
        </a>
        <a href="#work" class="link-quiet focus-ring rounded-sm">
          {hero.secondary}
        </a>
      </div>
    </div>
    <dl
      aria-label={hero.glance.label}
      class="hidden border-y border-line text-sm lg:grid lg:grid-cols-3 lg:divide-x lg:divide-line"
    >
      {glance.map((g) => (
        <div class="px-5 py-4 first:pl-0 last:pr-0">
          <dt class="text-label uppercase text-fg-3">{g.label}</dt>
          <dd class="mt-1 whitespace-nowrap text-fg tabular-nums">{g.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /*
   * Live particle mode (see HeroCanvas.astro and lib/hero/index.ts): the headline is real text for
   * readers, screen readers and search engines, but it is never painted while the hero runs.
   * `html[data-hero-intro="pending"]` (set inline before first paint when the hero will run) and
   * then `.is-forming` on the hero keep it invisible: the dust drifts, flies into the glyphs and
   * from then on *is* the name, one mote per device pixel, so nothing is ever hidden under type.
   * Without WebGL, or if the hero fails to start or loses its context, the flag and the class are
   * cleared and the headline simply shows. Horizontal swipes across the name reach the dust on
   * touch screens while vertical ones still scroll; the name is an object, not text to select.
   */
  html[data-hero-intro='pending'] .hero-name,
  [data-hero].is-forming .hero-name {
    opacity: 0;
  }
  .hero-name {
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    cursor: default;
  }
</style>
