---
import SectionHead from './SectionHead.astro';
import { testimonials } from '../data/testimonials';
import { sections } from '../data/copy';
---

<section id="testimonials" aria-labelledby="testimonials-h" class="py-section">
  <div class="container-site">
    <SectionHead
      index={sections.testimonials.index}
      label={sections.testimonials.label}
      id="testimonials-h"
    />
    <ul class="mt-12 grid gap-x-12 gap-y-14 lg:mt-16 lg:grid-cols-3" data-reveal>
      {testimonials.map((t, i) => (
        <li>
          <figure class="border-t border-line pt-6">
            <span class="block text-label text-oak-300 tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <blockquote class="quote mt-6 font-display text-quote font-[350] text-pretty text-fg">
              <p>{t.quote}</p>
            </blockquote>
            <figcaption class="mt-6 text-sm">
              <span class="font-medium text-fg">{t.name}</span>
              <span class="text-fg-3">{` · ${t.town}`}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
