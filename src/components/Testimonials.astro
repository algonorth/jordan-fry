---
import SectionHead from './SectionHead.astro';
import { testimonials } from '../data/testimonials';
import { sections } from '../data/copy';
---

<section id="testimonials" aria-labelledby="testimonials-h" class="py-section">
  <div class="container-site">
    <SectionHead
      index={sections.testimonials.index}
      label={sections.testimonials.label}
      id="testimonials-h"
    />
    <ul class="mt-12 grid gap-x-12 gap-y-16 lg:mt-16 lg:grid-cols-3" data-reveal>
      {testimonials.map((t) => (
        <li>
          <figure>
            <span class="mark block font-display text-amber-400" aria-hidden="true">
              “
            </span>
            <blockquote class="quote mt-2 font-display text-quote font-[350] text-pretty text-fg">
              <p>{t.quote}</p>
            </blockquote>
            <figcaption class="mt-6 text-sm">
              <span class="font-medium text-fg">{t.name}</span>
              <span class="text-fg-3">{` · ${t.town}`}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mark {
    font-size: 3.5rem;
    line-height: 0.7;
    font-variation-settings: 'opsz' 144;
    opacity: 0.85;
  }
</style>
