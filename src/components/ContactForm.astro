---
import { PUBLIC_WEB3FORMS_KEY } from 'astro:env/client';
import { contact } from '../data/copy';
import { site } from '../data/site';

const f = contact.form;
const key = PUBLIC_WEB3FORMS_KEY;
---

{key ? (
  <form
    id="contact-form"
    class="relative"
    action="https://api.web3forms.com/submit"
    method="POST"
    novalidate
    data-sending={f.sending}
    data-submit={f.submit}
  >
    <fieldset class="fields space-y-8">
      <input type="hidden" name="access_key" value={key} />
      <input type="hidden" name="subject" value="New project inquiry" />
      <input type="hidden" name="from_name" value={site.business} />
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
      />
      <div>
        <label for="cf-name" class="mb-2 block text-label uppercase text-fg-3">
          {f.name}
        </label>
        <input
          id="cf-name"
          name="name"
          type="text"
          class="field"
          autocomplete="name"
          required
          aria-describedby="cf-name-err"
          data-err-empty={f.errors.name}
        />
        <p id="cf-name-err" class="field-error" hidden />
      </div>
      <div>
        <label for="cf-reach" class="mb-2 block text-label uppercase text-fg-3">
          {f.reach}
        </label>
        <input
          id="cf-reach"
          name="reach"
          type="text"
          class="field"
          autocomplete="on"
          required
          aria-describedby="cf-reach-err"
          data-err-empty={f.errors.reachEmpty}
          data-err-invalid={f.errors.reachInvalid}
        />
        <p id="cf-reach-err" class="field-error" hidden />
      </div>
      <div>
        <label for="cf-need" class="mb-2 block text-label uppercase text-fg-3">
          {f.need}
        </label>
        <textarea
          id="cf-need"
          name="need"
          class="field"
          rows="4"
          required
          enterkeyhint="send"
          aria-describedby="cf-need-err"
          data-err-empty={f.errors.need}
        ></textarea>
        <p id="cf-need-err" class="field-error" hidden />
      </div>
      <div class="flex flex-wrap items-center gap-6">
        <button type="submit" class="btn-primary focus-ring w-full md:w-auto">
          {f.submit}
        </button>
        <p id="cf-network-err" class="text-sm text-error" role="alert" hidden>
          {f.errors.network}
        </p>
      </div>
    </fieldset>
    <div
      id="contact-success"
      class="success absolute inset-0 flex flex-col justify-center"
      role="status"
      tabindex="-1"
      hidden
    >
      <p class="font-display text-h2 text-fg">{f.success.title}</p>
      <p class="mt-4 max-w-md text-body text-fg-2">{f.success.text}</p>
    </div>
  </form>
) : (
  <p class="text-sm text-fg-3">
    {import.meta.env.DEV ? 'TODO: set PUBLIC_WEB3FORMS_KEY in .env to enable the form.' : ''}
  </p>
)}

<script>
  import '../lib/form';
</script>

<style>
  form {
    min-height: 28rem;
  }
  .field {
    display: block;
    width: 100%;
    height: 3.5rem;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--color-line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--color-fg);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    transition: border-color var(--duration-fast);
  }
  .field:focus {
    outline: none;
    border-bottom-color: var(--color-amber-400);
  }
  .field[aria-invalid='true'] {
    border-bottom-color: var(--color-error);
  }
  textarea.field {
    height: auto;
    min-height: 8rem;
    padding-block: 1rem;
    resize: vertical;
  }
  .field-error {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-error);
  }
  .fields {
    transition:
      opacity var(--duration-base) var(--ease-out-soft),
      visibility 0s linear var(--duration-base);
  }
  form.is-sent .fields {
    opacity: 0;
    visibility: hidden;
  }
  .success {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-soft) var(--duration-base);
  }
  form.is-sent .success {
    opacity: 1;
  }
</style>
