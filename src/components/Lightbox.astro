---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { work } from '../data/copy';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}
const { photos } = Astro.props;
const btn =
  'focus-ring inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-ink-800/80 text-fg transition-colors duration-(--duration-fast) hover:bg-ink-700';
const arrow = (d: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="${d}"/></svg>`;
---

<dialog
  id="lightbox"
  closedby="any"
  aria-label="Photo viewer"
  class="m-auto h-svh max-h-none w-screen max-w-none border-0 bg-transparent p-0 backdrop:bg-ink-950/92 backdrop:backdrop-blur-sm"
>
  <button
    type="button"
    class:list={[btn, 'absolute top-4 right-4']}
    data-lightbox-close
    aria-label={work.close}
    autofocus
  >
    <Fragment set:html={arrow('M6 6l12 12M18 6L6 18')} />
  </button>
  <div
    class="flex h-full w-full flex-col items-center justify-center gap-5 px-4 py-16 md:px-20"
    data-lightbox-stage
  >
    <ul class="contents">
      {photos.map((p, i) => (
        <li class="contents" data-slide={i} hidden>
          <Image
            src={p.src}
            alt={p.alt}
            class="max-h-[72svh] max-w-full rounded-lg object-contain select-none md:max-h-[78svh] md:max-w-[min(90vw,1400px)]"
            layout="none"
            loading="lazy"
            draggable="false"
          />
        </li>
      ))}
    </ul>
    <div class="flex w-full max-w-xl items-center justify-center gap-4 text-center">
      {photos.length > 1 && (
        <button type="button" class:list={[btn, 'md:hidden']} data-lightbox-prev aria-label="Previous photo">
          <Fragment set:html={arrow('M15 5l-7 7 7 7')} />
        </button>
      )}
      <div class="min-w-0 flex-1" aria-hidden="true">
        <span id="lightbox-count" class="block text-label uppercase text-oak-300 tabular-nums"></span>
        <span id="lightbox-caption" class="mt-1 block text-sm text-fg-2"></span>
      </div>
      {photos.length > 1 && (
        <button type="button" class:list={[btn, 'md:hidden']} data-lightbox-next aria-label="Next photo">
          <Fragment set:html={arrow('M9 5l7 7-7 7')} />
        </button>
      )}
    </div>
  </div>
  <p
    class="sr-only"
    aria-live="polite"
    id="lightbox-status"
    data-template={work.photoOf(0, photos.length)}
  ></p>
  {photos.length > 1 && (
    <>
      <button
        type="button"
        class:list={[btn, 'absolute top-1/2 left-4 hidden -translate-y-1/2 md:inline-flex']}
        data-lightbox-prev
        aria-label="Previous photo"
      >
        <Fragment set:html={arrow('M15 5l-7 7 7 7')} />
      </button>
      <button
        type="button"
        class:list={[btn, 'absolute top-1/2 right-4 hidden -translate-y-1/2 md:inline-flex']}
        data-lightbox-next
        aria-label="Next photo"
      >
        <Fragment set:html={arrow('M9 5l7 7-7 7')} />
      </button>
    </>
  )}
</dialog>

<script>
  import '../lib/lightbox';
</script>

<style>
  dialog[open] {
    animation: lightbox-in var(--duration-base) var(--ease-out-soft);
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
</style>
