---
import { services } from '../data/services';
import { services as copy } from '../data/copy';
---

<section id="services" aria-labelledby="services-h" class="scroll-mt-20 py-section">
  <div class="container-site" data-reveal>
    <h2 id="services-h" class="font-display text-h2 text-fg">
      {copy.heading}
    </h2>
    <ul class="mt-12 border-t border-line">
      {services.map((s, i) => (
        <li>
          <details class="disclosure group border-b border-line">
            <summary class="focus-ring flex cursor-pointer list-none items-baseline gap-6 py-6 [&::-webkit-details-marker]:hidden md:gap-10 md:py-8">
              <span class="w-8 shrink-0 text-label uppercase text-fg-3 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-display text-h2 text-fg transition-colors duration-(--duration-fast) group-hover:text-amber-300">
                {s.name}
              </span>
              <span class="plus ms-auto self-center text-fg-2" aria-hidden="true" />
            </summary>
            <p class="max-w-2xl pb-8 ps-14 text-body text-fg-2 md:ps-18">{s.text}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .plus {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
    transition: transform var(--duration-base) var(--ease-out-soft);
  }
  .plus::before {
    width: 100%;
    height: 1px;
  }
  .plus::after {
    width: 1px;
    height: 100%;
  }
  details[open] .plus::after {
    transform: rotate(90deg);
  }
</style>
