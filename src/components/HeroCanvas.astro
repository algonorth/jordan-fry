---
/**
 * Fixed layers behind the page (rendered into the layout's backdrop slot on the home page only):
 * a CSS light shaft that scrolls away with the hero and the particle canvas. Without WebGL, what is
 * here is already the designed static state. The hero deliberately ignores the OS reduced-motion
 * flag (see lib/hero/index.ts); `?motion=static` renders the finished frame for checks.
 *
 * The inline script below runs before the headline is parsed: if the hero is going to run it marks
 * `<html data-hero-intro="pending">`, which keeps the headline invisible so the dust can form it. Every
 * path that does not reach a live first frame clears the flag (fallback, static, failure, timeout).
 */
---

<div class="hero-shaft pointer-events-none absolute inset-x-0 top-0 z-0 h-[92svh]" aria-hidden="true"></div>
<canvas
  id="hero-canvas"
  class="pointer-events-none fixed inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-(--duration-slow) [&.is-live]:opacity-100 [&.is-static]:absolute [&.is-static]:h-[92svh]"
  aria-hidden="true"
></canvas>

<style>
  .hero-shaft {
    background: radial-gradient(
      60% 80% at 28% -10%,
      color-mix(in oklab, var(--color-amber-400) 14%, transparent),
      transparent 70%
    );
  }
</style>

<script is:inline>
  // Pre-paint capability probe (a few ms). Devices without a usable GPU never download the three.js
  // chunk and never hide the headline. `?gl=software` allows a software renderer (tests).
  (function () {
    if (!('WebGL2RenderingContext' in window)) return;
    try {
      var soft = /[?&]gl=software(?:&|$)/.test(location.search);
      var gl = document
        .createElement('canvas')
        .getContext('webgl2', { failIfMajorPerformanceCaveat: !soft });
      if (!gl) return;
      var lose = gl.getExtension('WEBGL_lose_context');
      if (lose) lose.loseContext();
      document.documentElement.dataset.heroIntro = 'pending';
    } catch (e) {
      /* no hero */
    }
  })();
</script>

<script>
  // The particle module is fetched at idle time, after load, only when the inline probe passed.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const nameEl = document.getElementById('hero-name');
  const heroEl = document.querySelector<HTMLElement>('[data-hero]');
  const params = new URLSearchParams(location.search);
  const allowSoftwareGL = params.get('gl') === 'software';
  const pending = document.documentElement.dataset.heroIntro === 'pending';
  /** Lets the headline show. Live mode calls it on its first frame, after `.is-forming` took over. */
  const reveal = () => {
    delete document.documentElement.dataset.heroIntro;
  };
  if (canvas && nameEl && heroEl && pending) {
    // Safety net: if the hero has not rendered a frame within a few seconds of load, show the name.
    const guard = setTimeout(reveal, 6000);
    const start = () =>
      import('../lib/hero')
        .then((m) =>
          m.mountHero(canvas, {
            nameEl,
            heroEl,
            allowSoftwareGL,
            reducedMotion: params.get('motion') === 'static',
            debug: params.get('debug') === 'hero',
            onReady: () => {
              clearTimeout(guard);
              reveal();
            },
          }),
        )
        .then((h) => {
          if (h.mode !== 'live') reveal();
        })
        .catch(reveal);
    const schedule = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 250);
    if (document.readyState === 'complete') schedule();
    else addEventListener('load', schedule, { once: true });
  }
</script>
