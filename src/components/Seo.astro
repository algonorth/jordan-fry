---
import { meta } from '../data/copy';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, ogType = 'website', ogImage, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = ogImage ?? new URL(withBase('/og.png'), Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#0F0D0B" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Jordan Fry, carpenter and contractor" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
