---
import { telHref, smsHref } from '../data/site';
import { callBar } from '../data/copy';
---

<nav
  id="callbar"
  aria-label={callBar.label}
  class="fixed inset-x-0 bottom-0 z-40 grid translate-y-full grid-cols-2 bg-ink-900 pb-[env(safe-area-inset-bottom)] transition-transform duration-(--duration-base) ease-out-soft md:hidden [&.is-visible]:translate-y-0"
>
  <a
    href={telHref}
    class="focus-ring flex h-14 items-center justify-center bg-amber-400 font-medium text-ink-950"
  >
    {callBar.call}
  </a>
  <a
    href={smsHref}
    class="focus-ring flex h-14 items-center justify-center border-t border-line bg-ink-900 font-medium text-fg"
  >
    {callBar.text}
  </a>
</nav>

<script>
  import '../lib/callbar';
</script>
