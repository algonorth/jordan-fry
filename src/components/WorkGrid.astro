---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
  /** Skip the reveal on the first card so it can peek in below the hero. */
  peekFirst?: boolean;
}
const { entries, peekFirst = false } = Astro.props;

/**
 * Asymmetric editorial rhythm by index; two columns on tablets, one on phones. The drawing sheets
 * are generated at exactly these aspects (scripts/make-drawings.mjs) so no cover is ever cropped.
 */
const pattern = [
  { span: 'lg:col-span-7', aspect: 'aspect-[4/3]', offset: '' },
  { span: 'lg:col-span-5', aspect: 'aspect-[3/4]', offset: '' },
  { span: 'lg:col-span-5', aspect: 'aspect-square', offset: '' },
  { span: 'lg:col-span-7', aspect: 'aspect-[16/10]', offset: '' },
  { span: 'md:col-span-2 lg:col-span-8 lg:col-start-3', aspect: 'aspect-[3/2]', offset: '' },
  { span: 'md:col-span-2 lg:col-span-6 lg:col-start-4', aspect: 'aspect-[4/3]', offset: '' },
];
---

<ul class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-12 lg:gap-x-8 lg:gap-y-16">
  {entries.map((entry, i) => {
    const p = pattern[i % pattern.length]!;
    return (
      <li class:list={[p.span, p.offset, 'md:self-end']} data-reveal={peekFirst && i === 0 ? undefined : ''}>
        <WorkCard entry={entry} aspect={p.aspect} index={i} />
      </li>
    );
  })}
</ul>
