---
import type { CollectionEntry } from 'astro:content';
import WorkImage from './WorkImage.astro';
import { withBase } from '../lib/url';

interface Props {
  entry: CollectionEntry<'work'>;
  aspect: string;
  index: number;
  sizes?: string;
}
const { entry, aspect, index, sizes = '(min-width: 64rem) 50vw, 100vw' } = Astro.props;
const { title, type, location, year, cover, placeholder } = entry.data;
const town = location.split(',')[0];
---

<a href={withBase(`/work/${entry.id}/`)} class="reveal-self group focus-ring block rounded-md">
  <figure
    class:list={['reveal-img relative overflow-hidden rounded-md bg-ink-900', aspect]}
    style={`view-transition-name: cover-${entry.id}`}
  >
    <WorkImage
      src={cover}
      alt=""
      sizes={sizes}
      class="work-img size-full object-cover group-hover:scale-[1.03] group-hover:brightness-[1.06] motion-reduce:group-hover:scale-100"
    />
    {import.meta.env.DEV && placeholder && (
      <span class="absolute top-3 right-3 rounded-sm bg-ink-950/70 px-2 py-1 text-xs text-fg-3">
        TODO photo
      </span>
    )}
  </figure>
  <div class="card-meta mt-4 grid grid-cols-[2rem_1fr] gap-x-4">
    <span class="pt-1.5 text-label text-oak-300 tabular-nums">{String(index + 1).padStart(2, '0')}</span>
    <span>
      <span class="block font-display text-h3 text-fg transition-colors duration-(--duration-fast) group-hover:text-amber-300">
        {title}
      </span>
      <span class="mt-1 block text-label uppercase text-fg-3 tabular-nums">{`${type} · ${town} · ${year}`}</span>
    </span>
  </div>
</a>
