---
import Sheet from './Sheet.astro';
import SectionHead from './SectionHead.astro';
import portrait from '../assets/portrait.svg';
import { about, sections } from '../data/copy';
import { site, hasHic } from '../data/site';
import { footer } from '../data/copy';

const credentials = site.credentials.map((c) =>
  c === footer.legal && hasHic ? `${c} · ${footer.hic(site.hic)}` : c,
);
---

<section id="about" aria-labelledby="about-h" class="scroll-mt-20 py-section">
  <div class="container-site">
    <SectionHead
      index={sections.about.index}
      label={sections.about.label}
      title={about.heading}
      id="about-h"
    />
    <div class="mt-12 grid items-start gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-16" data-reveal>
      <div class="reveal-self lg:col-span-5">
        <figure class="sheet-frame aspect-[4/5] overflow-hidden rounded-md bg-ink-900">
          <Sheet src={portrait} class="work-img size-full" decorative={false} label={about.portraitAlt} />
        </figure>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-lead text-fg">{about.paragraphs[0]}</p>
        <p class="mt-6 text-body text-fg-2">{about.paragraphs[1]}</p>
        <ul class="mt-10 flex flex-wrap gap-x-10 gap-y-3 border-t border-line pt-8 text-label uppercase text-fg-3">
          {credentials.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
